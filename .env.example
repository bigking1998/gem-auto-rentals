# Gem Auto Rentals — example environment
#
# Rewritten 2026-10-20 from the variables the code ACTUALLY reads. The previous
# version documented SendGrid, AWS S3 and Redis — none of which this project
# uses — so anyone following it configured two services that are never called
# and still had a broken app. See WEBSITE_AUDIT.md section 6.1.
#
# Copy to .env (server) and fill in. Never commit the filled-in file.

# ---- Core: required for the API to start ----
DATABASE_URL=            # Postgres connection string
DIRECT_URL=              # Postgres direct (non-pooled) connection, used by Prisma migrate
JWT_SECRET=              # long random string
JWT_EXPIRES_IN=7d        # how long a login lasts; "remember me" cannot outlive this
PORT=3000
NODE_ENV=development

# ---- URLs: used for CORS, links in emails, and SSO between the apps ----
WEB_URL=                 # customer site origin
ADMIN_URL=               # admin dashboard origin

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY=       # sk_test_... in every environment except production
STRIPE_PUBLISHABLE_KEY=  # pk_test_... / pk_live_...
STRIPE_WEBHOOK_SECRET=   # whsec_... from the Stripe dashboard webhook
# Leave UNSET in production. Setting it to "true" enables an endpoint that marks
# a booking paid without charging anything.
ALLOW_DEMO_PAYMENTS=

# ---- Email (Resend) ----
RESEND_API_KEY=
FROM_EMAIL=              # e.g. "Gem Car Rentals <bookings@gemrentalcars.com>"
# Required for bounce/complaint handling. Without it the webhook returns 503 and
# bounces are NEVER recorded, which silently degrades sending reputation.
RESEND_WEBHOOK_SECRET=

# ---- File storage (Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Each PUBLIC bucket has its OWN public URL (https://pub-xxxx.r2.dev).
# Without these, images upload fine but have no address and never display.
R2_VEHICLES_PUBLIC_URL=
R2_AVATARS_PUBLIC_URL=
R2_LOGOS_PUBLIC_URL=
# Optional single-bucket fallback used when the three above are unset.
R2_PUBLIC_URL=

# ---- Optional features ----
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_KEY_FILE=
GOOGLE_WALLET_CLASS_SUFFIX=
SOFT_DELETE_RETENTION_DAYS=   # defaults in code if unset
MIGRATION_KEY=                # guards the admin-only migration endpoint
SOURCE_DATABASE_URL=          # only for one-off data migration scripts
DRY_RUN=                      # scripts only

# ---- Front-end (Vite) — these ship in the browser bundle, never put secrets here ----
VITE_API_URL=
VITE_SITE_URL=
VITE_ADMIN_URL=
VITE_STRIPE_PUBLISHABLE_KEY=
